# Healthedge Aetna Functions - Polyglot for PowerShell and Bash
# Usage: PowerShell: . $PROFILE_DIR\Healthedge.Aetna_functions.polyglot
#        Git Bash:   source "$(cygpath "$USERPROFILE")/Documents/WindowsPowerShell/Healthedge.Aetna_functions.polyglot"

echo --% >/dev/null <<"out-null"
<#
out-null

#============================= BASH SECTION =============================
# This section runs only in Bash/Git Bash

# Default values
: "${GIT_HOME:=$HOME/hebb}"
: "${REPO_CWLSRC:=hrp.cust.aetna.payer}"
: "${REPO_AETNA_CONNECTOR:=hrp.cust.aetna.connector}"
: "${REPO_AETNA_TEST:=hrp.cust.aetna.test}"
: "${SEPARATE_BRANCH_DIRECTORIES:=true}"

# Initialize directories from saved defaults
_init_aetna_dirs() {
    local git_home_unix="$(cygpath "$GIT_HOME" 2>/dev/null || echo "$GIT_HOME")"
    
    # Initialize CWLSRCDIR
    if [ -z "$CWLSRCDIR" ]; then
        if [ -f "$HOME/.default-cwlsrc-branch" ]; then
            local branch=$(cat "$HOME/.default-cwlsrc-branch")
            export CWLSRCDIR="$GIT_HOME\\$REPO_CWLSRC-$branch"
        fi
    fi
    
    # Initialize AETNA_CONNECTOR_DIR
    if [ -z "$AETNA_CONNECTOR_DIR" ]; then
        if [ -f "$HOME/.default-aetna-connector-branch" ]; then
            local branch=$(cat "$HOME/.default-aetna-connector-branch")
            export AETNA_CONNECTOR_DIR="$GIT_HOME\\$REPO_AETNA_CONNECTOR-$branch"
        fi
    fi
    
    # Initialize AETNA_TEST_DIR
    if [ -z "$AETNA_TEST_DIR" ]; then
        if [ -f "$HOME/.default-aetna-test-branch" ]; then
            local branch=$(cat "$HOME/.default-aetna-test-branch")
            export AETNA_TEST_DIR="$GIT_HOME\\$REPO_AETNA_TEST-$branch"
        fi
    fi
}

# Set CWL Source (Payer) branch
setcwlsrc() {
    local branch_name="$1"
    local transient=false
    local clone_repo=false
    local create_env=false
    
    # Parse arguments
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            -transient|--transient) transient=true ;;
            -cloneRepo|--cloneRepo) clone_repo=true ;;
            -createEnv|--createEnv) create_env=true ;;
            -h|--help|-?)
                echo "Usage: setcwlsrc [<branchname>] [-transient] [-cloneRepo] [-createEnv]"
                echo "  -transient: Set branch transiently (don't save as default)"
                echo "  -cloneRepo: Clone repository if not exists"
                echo "  -createEnv: Create environment directory"
                return 0
                ;;
        esac
        shift
    done
    
    if [ -z "$branch_name" ]; then
        echo "Error: Branch name required. Usage: setcwlsrc <branch> [options]"
        return 1
    fi
    
    local br
    if [ "$branch_name" = "master" ]; then
        br="master"
    else
        br="release-$branch_name"
    fi
    
    echo "Setting current CWL Source branch to: $branch_name"
    
    # Save as default unless transient
    if [ "$transient" = false ]; then
        echo "Setting as default for CWL Source"
        echo "$branch_name" > "$HOME/.default-cwlsrc-branch"
    fi
    
    # Update directory
    if [ "$SEPARATE_BRANCH_DIRECTORIES" = "true" ]; then
        export CWLSRCDIR="$GIT_HOME\\$REPO_CWLSRC-$branch_name"
    else
        export CWLSRCDIR="$GIT_HOME\\$REPO_CWLSRC"
    fi
    
    local cwlsrc_unix="$(cygpath "$CWLSRCDIR" 2>/dev/null || echo "$CWLSRCDIR")"
    
    # Clone if needed
    if [ ! -d "$cwlsrc_unix" ]; then
        if [ "$clone_repo" = true ]; then
            echo "Cloning $REPO_CWLSRC..."
            local git_home_unix="$(cygpath "$GIT_HOME" 2>/dev/null || echo "$GIT_HOME")"
            cd "$git_home_unix"
            if [ "$SEPARATE_BRANCH_DIRECTORIES" = "true" ]; then
                git clone -b "$br" "git@github.com:HE-Core/$REPO_CWLSRC.git" "$REPO_CWLSRC-$branch_name"
            else
                git clone "git@github.com:HE-Core/$REPO_CWLSRC.git"
                cd "$REPO_CWLSRC"
                git checkout "$br"
            fi
        else
            echo "Warning: Directory does not exist: $cwlsrc_unix"
            echo "Use -cloneRepo to clone it."
        fi
    fi
    
    # Navigate to directory
    if [ -d "$cwlsrc_unix" ]; then
        cd "$cwlsrc_unix"
        echo "Successfully set CWL Source to branch: $branch_name"
        echo "Current directory: $(pwd)"
    fi
}

# Set Connector branch
setckrsrc() {
    local branch_name="$1"
    local transient=false
    local clone_repo=false
    local create_env=false
    
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            -transient|--transient) transient=true ;;
            -cloneRepo|--cloneRepo) clone_repo=true ;;
            -createEnv|--createEnv) create_env=true ;;
            -h|--help|-?)
                echo "Usage: setckrsrc [<branchname>] [-transient] [-cloneRepo] [-createEnv]"
                return 0
                ;;
        esac
        shift
    done
    
    if [ -z "$branch_name" ]; then
        echo "Error: Branch name required. Usage: setckrsrc <branch> [options]"
        return 1
    fi
    
    local br
    if [ "$branch_name" = "master" ]; then
        br="master"
    else
        br="release-$branch_name"
    fi
    
    echo "Setting current Aetna Connector branch to: $branch_name"
    
    if [ "$transient" = false ]; then
        echo "Setting as default for Aetna Connector"
        echo "$branch_name" > "$HOME/.default-aetna-connector-branch"
    fi
    
    if [ "$SEPARATE_BRANCH_DIRECTORIES" = "true" ]; then
        export AETNA_CONNECTOR_DIR="$GIT_HOME\\$REPO_AETNA_CONNECTOR-$branch_name"
    else
        export AETNA_CONNECTOR_DIR="$GIT_HOME\\$REPO_AETNA_CONNECTOR"
    fi
    
    local connector_unix="$(cygpath "$AETNA_CONNECTOR_DIR" 2>/dev/null || echo "$AETNA_CONNECTOR_DIR")"
    
    if [ ! -d "$connector_unix" ]; then
        if [ "$clone_repo" = true ]; then
            echo "Cloning $REPO_AETNA_CONNECTOR..."
            local git_home_unix="$(cygpath "$GIT_HOME" 2>/dev/null || echo "$GIT_HOME")"
            cd "$git_home_unix"
            if [ "$SEPARATE_BRANCH_DIRECTORIES" = "true" ]; then
                git clone -b "$br" "git@github.com:HE-Core/$REPO_AETNA_CONNECTOR.git" "$REPO_AETNA_CONNECTOR-$branch_name"
            else
                git clone "git@github.com:HE-Core/$REPO_AETNA_CONNECTOR.git"
                cd "$REPO_AETNA_CONNECTOR"
                git checkout "$br"
            fi
        else
            echo "Warning: Directory does not exist: $connector_unix"
            echo "Use -cloneRepo to clone it."
        fi
    fi
    
    if [ -d "$connector_unix" ]; then
        cd "$connector_unix"
        echo "Successfully set Aetna Connector to branch: $branch_name"
        echo "Current directory: $(pwd)"
    fi
}

# Set Test branch
setccisrc() {
    local branch_name="$1"
    local transient=false
    local clone_repo=false
    local create_env=false
    
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            -transient|--transient) transient=true ;;
            -cloneRepo|--cloneRepo) clone_repo=true ;;
            -createEnv|--createEnv) create_env=true ;;
            -h|--help|-?)
                echo "Usage: setccisrc [<branchname>] [-transient] [-cloneRepo] [-createEnv]"
